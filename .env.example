# Copy to .env — never commit the real one.
SECRET_KEY=change-me
DATABASE_URL=sqlite:///app.db
# Set to 1 to expose /demo (a read-only seeded sample organization)
ENABLE_DEMO=1

# --- AI assistant (all optional: without any of these the built-in rules still work) ---
# Gemini (cloud, FIRST choice; free key from aistudio.google.com/apikey). GEMINI_MODEL may list several ids, best first, separated by commas:
# every model has its own quota, so when one is limited the next is used at once; when all are, the site moves to Grok without delay.
# Take a Flash model one step behind the newest (looser limits) — the ids available to your key are listed in AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=
# Groq (cloud, free tier: console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Grok / xAI (cloud) — key from console.x.ai, model name from the same console (e.g. grok-4.3)
XAI_API_KEY=
XAI_MODEL=
# Claude (cloud)
ANTHROPIC_API_KEY=
# A local model (Ollama, LM Studio, vLLM...) — company data stays on the machine
AI_LOCAL_BASE_URL=
AI_LOCAL_MODEL=
AI_LOCAL_API_KEY=
